-- VIEWS
CREATE VIEW Active_Customers AS
SELECT
    u.LastName || ' ' || u.FirstName AS Customer,
    u.Email,
    COUNT(s.SaleId) AS Purchases_Count,
    SUM(s.Total) AS Total_Spent
FROM Sale s
JOIN User u ON s.ClientId = u.UserId
GROUP BY u.UserId
HAVING COUNT(s.SaleId) &gt;= 2
ORDER BY Total_Spent DESC;

CREATE VIEW Sales_Report AS
SELECT
    strftime('%Y-%m', s.SaleDate) AS Month,
    SUM(s.Total) AS Total_Sales,
    SUM((p.SalePrice - p.PurchasePrice) * s.Quantity) AS Profit
FROM Sale s
JOIN Product p ON s.ProductId = p.ProductId
GROUP BY strftime('%Y-%m', s.SaleDate)
ORDER BY Month DESC;

CREATE VIEW Product_Search AS
SELECT DISTINCT
    p.ProductId,
    p.Name,
    p.Manufacturer,
    p.SalePrice,
    a.Name AS Animal,
    c.Name AS Category,
    sc.Name AS Subcategory
FROM Product p
LEFT JOIN Animal a ON p.AnimalId = a.AnimalId
LEFT JOIN Category c ON p.CategoryId = c.CategoryId
LEFT JOIN Subcategory sc ON p.SubcategoryId = sc.SubcategoryId;

-- TRIGGERS
CREATE TRIGGER AutoTotal
BEFORE INSERT ON Sale
FOR EACH ROW
BEGIN
    SELECT NEW.Total = NEW.Quantity * (
        SELECT SalePrice FROM Product WHERE ProductId = NEW.ProductId
    );
END;

CREATE TRIGGER NewCustomerDiscount
BEFORE INSERT ON Sale
FOR EACH ROW
WHEN (SELECT COUNT(*) FROM Sale WHERE ClientId = NEW.ClientId) = 0
BEGIN
    SELECT NEW.Total = ROUND(NEW.Total * 0.9, 2);
END;

COMMIT;
